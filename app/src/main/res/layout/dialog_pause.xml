<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_overlay_panel"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TẠM DỪNG"
        android:textColor="#FFF0A0"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnResume"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_yellow"
        android:gravity="center"
        android:text="TIẾP TỤC"
        android:textColor="#1A1820"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnSettingsPause"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_yellow"
        android:gravity="center"
        android:text="CÀI ĐẶT"
        android:textColor="#1A1820"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_purple"
        android:gravity="center"
        android:text="VỀ TRANG CHỦ"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
