<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BACKGROUND -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/space_background"
        android:scaleType="centerCrop" />

    <!-- LỚP PHỦ TỐI NHẸ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#30000000" />

    <!-- NỘI DUNG MENU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="35dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREAM SHOOTER"
            android:textColor="#FF70D8"
            android:textSize="44sp"
            android:textStyle="bold"
            android:shadowColor="#8A00FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"
            android:layout_marginBottom="35dp" />

        <!-- PLAY -->
        <Button
            android:id="@+id/btnPlaying"
            android:layout_width="300dp"
            android:layout_height="65dp"
            android:text="PLAY"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#241000"
            android:background="@drawable/button_game"
            android:layout_marginBottom="18dp" />

        <!-- UPDATE -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="300dp"
            android:layout_height="65dp"
            android:text="UPDATE"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#241000"
            android:background="@drawable/button_game"
            android:layout_marginBottom="18dp" />

        <!-- ACHIEVEMENTS -->
        <Button
            android:id="@+id/btnAchievement"
            android:layout_width="300dp"
            android:layout_height="65dp"
            android:text="ACHIEVEMENTS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#241000"
            android:background="@drawable/button_game" />

    </LinearLayout>

</FrameLayout>