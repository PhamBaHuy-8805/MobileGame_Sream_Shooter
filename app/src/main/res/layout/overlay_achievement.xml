<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/achievementOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="@drawable/bg_overlay_dimmer"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/achievementPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_overlay_panel"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Thành tích 1 -->
            <LinearLayout style="@style/AchievementRow">

                <TextView
                    android:id="@+id/achievementIcon1"
                    style="@style/AchievementIcon"
                    android:text="🏆" />

                <LinearLayout style="@style/AchievementInfo">

                    <TextView
                        android:id="@+id/achievementName1"
                        style="@style/AchievementName"
                        android:text="@string/achievement_1_name" />

                    <TextView
                        android:id="@+id/achievementDesc1"
                        style="@style/AchievementDesc"
                        android:text="@string/achievement_1_desc" />

                    <TextView
                        android:id="@+id/achievementProgressText1"
                        style="@style/AchievementProgressText"
                        android:text="0/0" />

                    <ProgressBar
                        android:id="@+id/achievementProgress1"
                        style="@style/AchievementProgressBar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievementReward1"
                    style="@style/AchievementReward"
                    android:text="0 ★" />
            </LinearLayout>

            <!-- Thành tích 2 -->
            <LinearLayout style="@style/AchievementRow">

                <TextView
                    android:id="@+id/achievementIcon2"
                    style="@style/AchievementIcon"
                    android:text="💗" />

                <LinearLayout style="@style/AchievementInfo">

                    <TextView
                        android:id="@+id/achievementName2"
                        style="@style/AchievementName"
                        android:text="@string/achievement_2_name" />

                    <TextView
                        android:id="@+id/achievementDesc2"
                        style="@style/AchievementDesc"
                        android:text="@string/achievement_2_desc" />

                    <TextView
                        android:id="@+id/achievementProgressText2"
                        style="@style/AchievementProgressText"
                        android:text="0/0" />

                    <ProgressBar
                        android:id="@+id/achievementProgress2"
                        style="@style/AchievementProgressBar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievementReward2"
                    style="@style/AchievementReward"
                    android:text="0 ★" />
            </LinearLayout>

            <!-- Thành tích 3 -->
            <LinearLayout style="@style/AchievementRow">

                <TextView
                    android:id="@+id/achievementIcon3"
                    style="@style/AchievementIcon"
                    android:text="🧲" />

                <LinearLayout style="@style/AchievementInfo">

                    <TextView
                        android:id="@+id/achievementName3"
                        style="@style/AchievementName"
                        android:text="@string/achievement_3_name" />

                    <TextView
                        android:id="@+id/achievementDesc3"
                        style="@style/AchievementDesc"
                        android:text="@string/achievement_3_desc" />

                    <TextView
                        android:id="@+id/achievementProgressText3"
                        style="@style/AchievementProgressText"
                        android:text="0/0" />

                    <ProgressBar
                        android:id="@+id/achievementProgress3"
                        style="@style/AchievementProgressBar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievementReward3"
                    style="@style/AchievementReward"
                    android:text="0 ★" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/achievementTitle"
        layout="@layout/view_overlay_title"
        android:layout_width="210dp"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp" />

    <include
        android:id="@+id/achievementClose"
        layout="@layout/view_overlay_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

</FrameLayout>
