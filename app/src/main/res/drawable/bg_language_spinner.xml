<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Viền đen ngoài -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111018" />
            <stroke
                android:width="2dp"
                android:color="#08080B" />
            <corners android:radius="5dp" />
        </shape>
    </item>

    <!-- Nền tím xám bên trong -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">
            <solid android:color="#383344" />
            <stroke
                android:width="1dp"
                android:color="#8F879C" />
            <corners android:radius="3dp" />
        </shape>
    </item>

</layer-list>
