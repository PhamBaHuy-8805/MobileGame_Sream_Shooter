<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#D89B00"/>

            <corners android:radius="14dp"/>

            <stroke
                android:width="3dp"
                android:color="#5C3A00"/>

            <padding
                android:left="20dp"
                android:top="10dp"
                android:right="20dp"
                android:bottom="10dp"/>

        </shape>
    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#FFD83D"/>

            <corners android:radius="14dp"/>

            <stroke
                android:width="3dp"
                android:color="#5C3A00"/>

            <padding
                android:left="20dp"
                android:top="10dp"
                android:right="20dp"
                android:bottom="10dp"/>

        </shape>

    </item>

</selector>